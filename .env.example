# Copy this to .env.local and adjust if needed
VITE_API_URL=http://127.0.0.1:4001/api

# ── Backend (optional — defaults shown) ─────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database
# SESSION_SECRET=generate-a-unique-random-secret-at-least-32-characters
# IMAGEKIT_PRIVATE_KEY=server-side-private-key
# IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
# Local frontend origins (the backend also allows these explicitly in development).
# On Render, set CORS_ORIGIN to the exact production Vercel origin without a path,
# for example: https://internshield-pmio.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ── Hybrid Scam Detection Engine ────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here          # Backend-only; required for AI analysis and chatbot
# GEMINI_MODEL=gemini-3.8-flash                     # Optional backend model override
# OCR_BACKEND=auto                                  # auto | tesseract | demo
                                                    # auto: Use Tesseract if installed; otherwise return a clear service error
                                                    # tesseract: Force Tesseract OCR (requires installation)
                                                    # demo: Explicit development/test mode only; uses sample text, not OCR

# ── Performance Optimization ────────────────────────────────────────────────
# SKIP_AI_VALIDATION=false                          # Set to 'true' for faster analysis without AI
                                                    # Analysis will complete in ~1-2 seconds instead of 5-10 seconds
                                                    # Evidence-based rules still run, only AI validation is skipped
