# Copy this to .env.local and adjust if needed
VITE_API_URL=http://127.0.0.1:4000/api

# ── Backend (optional — defaults shown) ─────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/scamshield
# SESSION_SECRET=dev-secret-change-me
# CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Hybrid Scam Detection Engine ────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here          # Required for AI analysis layer
# OCR_BACKEND=auto                                  # auto | tesseract | demo
                                                    # auto: Use Tesseract if available, else demo
                                                    # tesseract: Force Tesseract OCR (requires installation)
                                                    # demo: Use demo text for testing (no real OCR)

# ── Performance Optimization ────────────────────────────────────────────────
# SKIP_AI_VALIDATION=false                          # Set to 'true' for faster analysis without AI
                                                    # Analysis will complete in ~1-2 seconds instead of 5-10 seconds
                                                    # Evidence-based rules still run, only AI validation is skipped